# Variables de entorno para la cámara y el pipeline local
# Copia este archivo a .env y ajusta los valores según tu setup.

CAMERA_URL=http://192.168.1.10:8080/video
CAPTURE_WIDTH=640
CAPTURE_HEIGHT=480
FRAME_SKIP=0
KMEANS_CLUSTERS=4
KMEANS_MAX_ITER=25
KMEANS_DOWNSCALE=0.5
DEBUG_WINDOW_NAME=Robot Vision
USE_MJPEG=false

# Dirección Bluetooth del mBot físico (ver config.py, usada por
# comunicacion/salida_mbot.py). Cada integrante la reemplaza por la MAC
# de su propio robot.
MAC_MBOT=00:1B:10:21:2C:1B

# Futuras etapas del robot:
# LINE_DETECTION_THRESHOLD=...
# SIGNAL_RED_MIN_HSV=...
# SIGNAL_GREEN_MIN_HSV=...
