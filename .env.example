# Copia a .env y ajusta la fuente, orientación y ganancias al robot real.

CAMERA_URL=http://192.168.1.10:8080/video
CAPTURE_WIDTH=640
CAPTURE_HEIGHT=480
FRAME_SKIP=0
# Orientación de entrada: 0, 90, 180 o 270 grados en sentido horario.
ROTATION=0
PROCESS_WIDTH=280
LINE_ROI_START=0.48
SIGNAL_ROI_END=0.78
LINE_RECALIBRATE_EVERY=12
LINE_THRESHOLD=100
LINE_MIN_BAND_PIXELS=3
SIGNAL_MIN_AREA=180
SIGNAL_CONFIRM_HITS=3
SIGNAL_HISTORY_SIZE=5
SIGNAL_TRIGGER_Y=0.65
STOP_SECONDS=3.0
RESUME_IGNORE_SECONDS=2.0
BASE_SPEED=90
KP=0.7
KD=0.18
KA=0.35
MAX_TURN=100
LOST_LINE_CONFIDENCE=0.12
CALIBRATION_FILE=calibration.json
BLUETOOTH_MAC=
BLUETOOTH_PORT=1
# Vacío usa la ruta hermana robotEjecutor/practica-vision-artificial-robotica/master_pc.
ROBOT_EXECUTOR_PATH=
ROBOT_TURN_DEADBAND=25
ROBOT_MIN_PULSE_INTERVAL=0.14
ROBOT_MAX_PULSE_INTERVAL=0.8
PHONE_CAMERA_HOST=0.0.0.0
PHONE_CAMERA_PORT=5000
# Necesitas ambos archivos para HTTPS; el celular debe confiar en el certificado.
PHONE_CAMERA_TLS_CERT=
PHONE_CAMERA_TLS_KEY=
KMEANS_CLUSTERS=4
KMEANS_MAX_ITER=25
KMEANS_DOWNSCALE=0.5
DEBUG_WINDOW_NAME=Robot Vision
USE_MJPEG=false
